{
  "name": "hostlink_cms",
  "version": "1.0.0",
  "description": "hostlink website built with Payload CMS and Next.js",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "NODE_OPTIONS=--no-deprecation next build",
    "db:migrate": "sh ./scripts/ensure-payload-container.sh && docker compose exec -T payload pnpm db:migrate:container",
    "db:migrate:create": "sh ./scripts/ensure-payload-container.sh && docker compose exec -T payload pnpm db:migrate:create:container",
    "db:migrate:container": "pnpm payload migrate",
    "db:migrate:create:container": "pnpm payload migrate:create",
    "db:restore-point": "sh ./scripts/create-db-restore-point.sh",
    "dev": "docker compose up -d",
    "dev:container": "NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "sh ./scripts/ensure-payload-container.sh && docker compose exec -T payload pnpm generate:importmap:container",
    "generate:importmap:container": "NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "sh ./scripts/ensure-payload-container.sh && docker compose exec -T payload pnpm generate:types:container",
    "generate:types:container": "NODE_OPTIONS=--no-deprecation payload generate:types",
    "i18n:scan-hardcoded": "NODE_OPTIONS=--no-deprecation tsx src/scripts/scan-hardcoded-ui-copy.ts",
    "lint": "oxlint",
    "logs": "docker compose logs -f payload",
    "payload": "sh ./scripts/ensure-payload-container.sh && docker compose exec payload pnpm payload:container",
    "payload:container": "NODE_OPTIONS=--no-deprecation payload",
    "postbuild": "next-sitemap --config next-sitemap.config.cjs",
    "rebuild:container": "docker compose up --build --force-recreate -d payload",
    "recreate": "docker compose up --force-recreate -d payload",
    "restart:container": "docker compose restart payload",
    "start": "NODE_OPTIONS=--no-deprecation next start",
    "storybook": "NODE_OPTIONS=--no-deprecation storybook dev -p 6006",
    "test-storybook": "vitest --project=storybook",
    "build-storybook": "NODE_OPTIONS=--no-deprecation storybook build",
    "test": "sh ./scripts/ensure-payload-container.sh && docker compose exec -T payload pnpm test:container",
    "test:container": "pnpm run test:int:container && pnpm run test:e2e:container",
    "test:e2e": "sh ./scripts/ensure-payload-container.sh && docker compose exec -T payload pnpm test:e2e:container",
    "test:e2e:container": "NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "sh ./scripts/ensure-payload-container.sh && docker compose exec -T payload pnpm test:int:container",
    "test:int:container": "NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts --project integration"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@payloadcms/admin-bar": "3.93.0",
    "@payloadcms/db-postgres": "3.93.0",
    "@payloadcms/email-nodemailer": "3.93.0",
    "@payloadcms/live-preview-react": "3.93.0",
    "@payloadcms/next": "3.93.0",
    "@payloadcms/plugin-form-builder": "3.93.0",
    "@payloadcms/plugin-mcp": "3.93.0",
    "@payloadcms/plugin-nested-docs": "3.93.0",
    "@payloadcms/plugin-redirects": "3.93.0",
    "@payloadcms/plugin-search": "3.93.0",
    "@payloadcms/plugin-seo": "3.93.0",
    "@payloadcms/richtext-lexical": "3.93.0",
    "@payloadcms/ui": "3.93.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "18.0.10",
    "graphql": "^16.15.0",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "next-sitemap": "^4.2.3",
    "payload": "3.93.0",
    "prism-react-renderer": "^2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "shadcn": "^4.23.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-mcp": "^10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/nextjs-vite": "10.6.7",
    "@storybook/react": "10.6.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.12",
    "@types/escape-html": "^1.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-v8": "5.1.0",
    "autoprefixer": "^10.6.2",
    "esbuild": "^0.28.2",
    "fallow": "^3.43.2",
    "jsdom": "31.0.1",
    "mcp-add": "^0.2.4",
    "mockdate": "^3.0.5",
    "msw": "^3.0.6",
    "msw-storybook-addon": "^3.0.3",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "storybook": "10.6.7",
    "tailwindcss": "^4.3.5",
    "tsx": "4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
